# ==========================================================
# EDGEFLO (QODER COPY) — SERVER ENV EXAMPLE
# Copy to server/.env and fill in real values.
# NEVER commit real secrets.
# ==========================================================

# Backend port (default 4000)
PORT=4000

# Qoder frontend origin (used for CORS + OAuth redirects)
FRONTEND_URL=http://localhost:5174

# Python MT5 bridge (mt5-bridge/app.py)
MT5_BRIDGE_URL=http://127.0.0.1:5001

# cTrader Open API OAuth app credentials
# Create an app at https://id.ctrader.com/my/settings/openapi
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=http://localhost:4000/api/ctrader/callback

# Google Gemini (AI Trading Assistant, server/routes/ai.js)
# Create a key at https://aistudio.google.com/apikey — server side only.
# Never move this key to the frontend .env files.
GEMINI_API_KEY=

# Optional: override the Gemini model used for chat.
# gemini-2.5-flash is rejected by Google for newer keys. Verified working here:
# gemini-3.7-flash (default), gemini-flash-latest, gemini-3.1-flash-lite (fastest).
GEMINI_MODEL=gemini-3.7-flash
