# ==========================================================
# EDGEFLO (QODER COPY) — FRONTEND ENV EXAMPLE
# Copy to .env.local and fill in real values.
# NEVER commit real secrets.
# ==========================================================

# Backend API (Node/Express broker server)
VITE_API_URL=http://localhost:4000

# Trading Economics news calendar API key (backend proxy in vite.config.js)
TE_API_KEY=

# Twelve Data market data API key (src/services/twelveData.js)
VITE_TWELVE_DATA_KEY=

# Supabase Auth (the Google provider is configured by Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional when running inside the v0 preview
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=
